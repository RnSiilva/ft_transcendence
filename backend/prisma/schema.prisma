generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?  @db.LongText // Optional: defaults to null until uploaded/selected by user
  language     String   @default("pt") // Default language is 'pt' (supports 'pt', 'en', 'es')
  rank         Int      @default(0)
  totalPoints  Int      @default(0)
  gamesPlayed  Int      @default(0)
  wins         Int      @default(0)
  createdAt    DateTime @default(now())

  friendsSent     Friend[] @relation("UserFriends")
  friendsReceived Friend[] @relation("FriendUser")
  reportsReceived Report[] @relation("Reported")
  reportsMade     Report[] @relation("Reporter")
  gameScores      GameScore[]
}

model Friend {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  status    String
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id])
  friend User @relation("FriendUser", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Word {
  id         Int     @id @default(autoincrement())
  theme      String
  textPt     String  @unique
  textEn     String  @unique
  textEs     String  @unique
  difficulty String?
}

model Report {
  id         Int      @id @default(autoincrement())
  reportedId Int
  reporterId Int
  roomCode   String
  reason     String
  createdAt  DateTime @default(now())

  reported User @relation("Reported", fields: [reportedId], references: [id])
  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@unique([reportedId, reporterId, roomCode])
}

model Game {
  id          Int      @id @default(autoincrement())
  roomCode    String
  theme       String
  language    String
  rounds      Int
  roundSeconds Int
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  scores GameScore[]
}

/// One row per player per finished game: what they scored and whether they won.
/// Leaderboards read this and group by finishedAt, so a daily or weekly table
/// is a date filter rather than a second set of counters to keep in step.
model GameScore {
  id         Int      @id @default(autoincrement())
  gameId     Int
  userId     Int
  points     Int
  won        Boolean  @default(false)
  finishedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([finishedAt])
  @@index([userId, finishedAt])
}
