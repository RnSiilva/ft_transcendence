generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String?
  intraId      Int?     @unique
  avatarUrl    String?  @db.LongText // Optional: defaults to null until uploaded/selected by user
  language     String   @default("pt") // Default language is 'pt' (supports 'pt', 'en', 'es')
  rank         Int      @default(0)
  totalPoints  Int      @default(0)
  gamesPlayed  Int      @default(0)
  wins         Int      @default(0)
  createdAt    DateTime @default(now())

  friendsSent     Friend[] @relation("FriendsSent")
  friendsReceived Friend[] @relation("FriendsReceived")
  reportsReceived Report[] @relation("Reported")
  reportsMade     Report[] @relation("Reporter")
}

model Friend {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  sender   User @relation("FriendsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Word {
  id         Int     @id @default(autoincrement())
  theme      String
  textPt     String  @unique
  textEn     String  @unique
  textEs     String  @unique
  difficulty String?
}

model Report {
  id         Int      @id @default(autoincrement())
  reportedId Int
  reporterId Int
  roomCode   String
  reason     String
  createdAt  DateTime @default(now())

  reported User @relation("Reported", fields: [reportedId], references: [id])
  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@unique([reportedId, reporterId, roomCode])
}
